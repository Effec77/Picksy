{
  "name": "picksy-refactor",
  "version": "1.0.0",
  "description": "Picksy price tracking system - refactored for legal compliance and production readiness",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/shared",
    "src/api-gateway",
    "src/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=src/shared",
    "build:api": "npm run build --workspace=src/api-gateway",
    "build:extension": "npm run build --workspace=src/extension",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch --workspaces",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rm -rf src/*/dist",
    "dev:api": "npm run dev --workspace=src/api-gateway",
    "start:api": "npm run start --workspace=src/api-gateway",
    "package:extension": "npm run package --workspace=src/extension",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/picksy-refactor.git"
  },
  "keywords": [
    "price-tracking",
    "browser-extension",
    "e-commerce",
    "legal-compliance",
    "api-gateway"
  ],
  "author": "Picksy Team",
  "license": "MIT"
}