{
    "manifest_version": 3,
    "name": "Picksy",
    "description": "Cross-site shopping assistant: extract product info, compare, and recommend with trust signals.",
    "version": "0.2.0",
    "action": {
      "default_title": "Picksy",
      "default_popup": "src/popup/popup.html"
    },
    "background": {
      "service_worker": "src/background/background.js"
    },
    "icons": {
      "16": "assets/logo.png",
      "48": "assets/logo.png",
      "128": "assets/logo.png"
    },
    "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "notifications"],
    "host_permissions": ["<all_urls>"],

    "options_ui": {
      "page": "src/popup/popup.html",
      "open_in_tab": false
    }
  }
  